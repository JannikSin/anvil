{
  "_note": "The programme, bundled into the app shell so anvil is usable on first open with no token and no network. Structure and coaching cues only: this repo is public and never carries real logged data, loads, or personal health details. The live copy lives in the private data repo and wins whenever it loads.",
  "schedule": {
    "mon": "lower-a",
    "tue": "pull-a",
    "wed": "push-a",
    "thu": "pull-b",
    "fri": "lower-b",
    "sat": "push-b",
    "sun": null
  },
  "templates": [
    {
      "id": "lower-a",
      "name": "Lower A (Squat focus)",
      "exercises": [
        {
          "name": "Med Ball Slam",
          "targetSets": 3,
          "targetReps": "8",
          "increment": 5,
          "rest": 90,
          "note": "Power, first, while fresh. Throw it hard, do not grind it. The only rate-of-force work in the week."
        },
        {
          "name": "Back Squat",
          "targetSets": 4,
          "targetReps": "5-8",
          "increment": 10,
          "rest": 180,
          "note": "Primary. Leave 1-2 in reserve. Depth + control."
        },
        {
          "name": "Leg Press",
          "targetSets": 3,
          "targetReps": "10-12",
          "increment": 10,
          "rest": 180
        },
        {
          "name": "Seated Leg Curl",
          "targetSets": 3,
          "targetReps": "10-12",
          "increment": 10,
          "rest": 90
        },
        {
          "name": "Standing Calf Raise",
          "targetSets": 2,
          "targetReps": "12-15",
          "increment": 10,
          "rest": 90,
          "note": "Pause + full stretch at the bottom."
        }
      ]
    },
    {
      "id": "pull-a",
      "name": "Pull A (Back/Biceps, heavy)",
      "exercises": [
        {
          "name": "Weighted Pull-up or Lat Pulldown",
          "targetSets": 4,
          "targetReps": "6-10",
          "increment": 5,
          "rest": 180,
          "note": "Builds the muscle-up. Full dead-hang stretch, chest to bar."
        },
        {
          "name": "Chest-Supported Row (or DB Row)",
          "targetSets": 3,
          "targetReps": "8-12",
          "increment": 5,
          "rest": 180,
          "note": "Strict, pad stops cheating. Squeeze + pause."
        },
        {
          "name": "Face Pull",
          "targetSets": 2,
          "targetReps": "15-20",
          "increment": 5,
          "rest": 90,
          "note": "Shoulder health. Do not skip."
        },
        {
          "name": "Incline DB Curl",
          "targetSets": 3,
          "targetReps": "8-12",
          "increment": 5,
          "rest": 90,
          "note": "Arms behind torso = deep biceps stretch. Last set to failure."
        }
      ]
    },
    {
      "id": "push-a",
      "name": "Push A (Chest/Shoulders/Tri)",
      "exercises": [
        {
          "name": "Incline DB Press",
          "targetSets": 4,
          "targetReps": "6-10",
          "increment": 5,
          "rest": 180,
          "note": "Main press."
        },
        {
          "name": "Flat Bench or Machine Chest Press",
          "targetSets": 2,
          "targetReps": "8-10",
          "increment": 5,
          "rest": 180
        },
        {
          "name": "Overhead Press",
          "targetSets": 3,
          "targetReps": "6-10",
          "increment": 5,
          "rest": 180
        },
        {
          "name": "Cable Lateral Raise",
          "targetSets": 2,
          "targetReps": "12-20",
          "increment": 5,
          "rest": 90
        },
        {
          "name": "Overhead Triceps Extension",
          "targetSets": 2,
          "targetReps": "10-15",
          "increment": 5,
          "rest": 90,
          "note": "Full stretch overhead."
        }
      ]
    },
    {
      "id": "pull-b",
      "name": "Pull B (Back width/Grip + skill)",
      "exercises": [
        {
          "name": "Pull-up / Muscle-up Skill Work",
          "targetSets": 1,
          "targetReps": "10 min",
          "increment": 5,
          "rest": 120,
          "note": "FRESH, first: explosive pull-ups, high pulls, straight-bar dips, slow negatives."
        },
        {
          "name": "Lat Pulldown (wide) or Pull-up",
          "targetSets": 4,
          "targetReps": "8-12",
          "increment": 5,
          "rest": 180
        },
        {
          "name": "Single-arm DB Row",
          "targetSets": 3,
          "targetReps": "10-12",
          "increment": 5,
          "rest": 180,
          "note": "Big stretch. Last set near failure."
        },
        {
          "name": "Straight-arm Pulldown",
          "targetSets": 2,
          "targetReps": "12-15",
          "increment": 5,
          "rest": 90,
          "note": "Lat stretch."
        },
        {
          "name": "Rear Delt Fly",
          "targetSets": 2,
          "targetReps": "15",
          "increment": 5,
          "rest": 90
        },
        {
          "name": "Dead Hang",
          "targetSets": 2,
          "targetReps": "max time",
          "increment": 5,
          "rest": 90,
          "note": "Grip + shoulder decompression. Bar, open hand, never an edge."
        }
      ]
    },
    {
      "id": "lower-b",
      "name": "Lower B (Hinge focus)",
      "exercises": [
        {
          "name": "Med Ball Side Toss",
          "targetSets": 3,
          "targetReps": "6 each",
          "increment": 5,
          "rest": 90,
          "note": "Rotational power, first, while fresh. The transverse plane nothing else trains."
        },
        {
          "name": "Romanian Deadlift",
          "targetSets": 4,
          "targetReps": "6-10",
          "increment": 10,
          "rest": 180,
          "note": "Leave 1-2 in reserve. Hinge, feel the hamstring stretch."
        },
        {
          "name": "Lateral Lunge",
          "targetSets": 3,
          "targetReps": "8 each",
          "increment": 10,
          "rest": 120,
          "note": "THE frontal plane, taken from Ben's sheet. You play a lateral sport and this programme trained one plane."
        },
        {
          "name": "Bulgarian Split Squat",
          "targetSets": 3,
          "targetReps": "8-10 each",
          "increment": 10,
          "rest": 180,
          "note": "Single-leg strength; carries over to court and rock."
        },
        {
          "name": "Seated Leg Curl",
          "targetSets": 2,
          "targetReps": "12-15",
          "increment": 10,
          "rest": 90
        }
      ]
    },
    {
      "id": "push-b",
      "name": "Push B (Upper pump + weak points)",
      "exercises": [
        {
          "name": "Machine/DB Chest Press",
          "targetSets": 3,
          "targetReps": "10-15",
          "increment": 5,
          "rest": 180
        },
        {
          "name": "DB Half-Kneeling One-Arm Press",
          "targetSets": 3,
          "targetReps": "8 each",
          "increment": 5,
          "rest": 120,
          "note": "From Ben's sheet. A shoulder-friendlier overhead position than a loaded bilateral press."
        },
        {
          "name": "Lateral Raise",
          "targetSets": 3,
          "targetReps": "15-20",
          "increment": 5,
          "rest": 90
        },
        {
          "name": "Incline DB Curl",
          "targetSets": 2,
          "targetReps": "10-15",
          "increment": 5,
          "rest": 90
        },
        {
          "name": "Triceps Pushdown",
          "targetSets": 2,
          "targetReps": "12-15",
          "increment": 5,
          "rest": 90
        },
        {
          "name": "Side Plank with Hip Hike",
          "targetSets": 3,
          "targetReps": "10 each",
          "increment": 5,
          "rest": 90,
          "note": "From Ben's sheet, and it upgrades the bodyweight version in Core. Anti-lateral-flexion, loaded."
        }
      ]
    }
  ]
}
